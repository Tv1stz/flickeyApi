# Flickey Go Backend — Environment Configuration
# Copy this file to .env and fill in the values.

# ── Server ────────────────────────────────────────────────────────────────────
ENVIRONMENT=dev
PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://rental:rental_dev@localhost:5432/flickey

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT (REQUIRED — must be at least 32 bytes) ────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-32-bytes-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Dev-friendly overrides (uncomment for development):
# JWT_ACCESS_TTL_SECONDS=86400

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_PHONE_PER_HOUR=5
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20
OTP_RESEND_COOLDOWN_SECONDS=60

# Dev-friendly overrides (uncomment for development):
# OTP_MAX_REQUESTS_PER_PHONE_PER_HOUR=1000
# OTP_RESEND_COOLDOWN_SECONDS=0
# OTP_MAX_VERIFY_ATTEMPTS=50

# ── Security ──────────────────────────────────────────────────────────────────
ALLOWED_REDIRECT_HOSTS=
COOKIE_DOMAIN=
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

# ── S3 / Selectel Storage ─────────────────────────────────────────────────────
# Leave S3_ACCESS_KEY empty to use local filesystem storage in dev.
S3_ENDPOINT_URL=s3.gis-1.storage.selcloud.ru
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=flickey
S3_REGION=gis-1
S3_PUBLIC_BASE_URL=
S3_PRESIGNED_URL_TTL_SECONDS=300

# ── Media ─────────────────────────────────────────────────────────────────────
MEDIA_MAX_FILE_SIZE_BYTES=15728640
MEDIA_MIN_COUNT=5
MEDIA_MAX_COUNT=15
